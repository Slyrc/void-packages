# Based on upstream rules shipped with tiny-dfr (Debian source package),
# but adjusted for non-systemd setups:
# - Remove SYSTEMD_WANTS
# - Replace SYSTEMD_ALIAS with plain udev SYMLINKs

# Touch Bar USB mode toggle (T2 Macs). Harmless if it never matches.
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="05ac", ATTR{idProduct}=="8302", ATTR{bConfigurationValue}=="1", ATTR{bConfigurationValue}="0", ATTR{bConfigurationValue}="2"

# Stable device names for tiny-dfr
SUBSYSTEM=="drm", KERNEL=="card[0-9]*", DRIVERS=="adp|appletbdrm", SYMLINK+="tiny_dfr_display"

SUBSYSTEM=="backlight", KERNEL=="appletb_backlight", DRIVERS=="hid-appletb-bl", SYMLINK+="tiny_dfr_backlight"
SUBSYSTEM=="backlight", KERNEL=="228200000.display-pipe.0", DRIVERS=="panel-summit", SYMLINK+="tiny_dfr_backlight"
SUBSYSTEM=="backlight", KERNELS=="228600000.dsi.0", DRIVERS=="panel-summit", SYMLINK+="tiny_dfr_backlight"

SUBSYSTEM=="backlight", KERNEL=="apple-panel-bl", SYMLINK+="tiny_dfr_display_backlight"
SUBSYSTEM=="backlight", KERNEL=="gmux_backlight", SYMLINK+="tiny_dfr_display_backlight"
SUBSYSTEM=="backlight", KERNEL=="intel_backlight", SYMLINK+="tiny_dfr_display_backlight"
SUBSYSTEM=="backlight", KERNEL=="acpi_video0", SYMLINK+="tiny_dfr_display_backlight"
